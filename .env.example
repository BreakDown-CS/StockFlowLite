# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=stockflow_user
DB_PASSWORD=stockflow_dev_password
DB_NAME=stockflow_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_TIMEOUT=3s
