# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=stockflow_user
DB_PASSWORD=stockflow_dev_password
DB_NAME=stockflow_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_TIMEOUT=3s
DB_STATEMENT_TIMEOUT=15s

# ---------------------------------------------------------------------------
# HTTP hardening (Phase 9)
# ---------------------------------------------------------------------------
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=30s
APP_IDLE_TIMEOUT=60s
APP_BODY_LIMIT_BYTES=1048576

# ---------------------------------------------------------------------------
# Authentication (Phase 7)
# AUTH_TOKEN_PEPPER must be at least 16 characters and must be unique per
# deployment. Never reuse the development value in production: the service
# refuses to start outside development while the default is in use.
# ---------------------------------------------------------------------------
AUTH_TOKEN_TTL=12h
AUTH_TOKEN_PEPPER=change-me-development-pepper
AUTH_PBKDF2_ITERATIONS=600000
AUTH_MAX_LOGIN_ATTEMPTS=8
AUTH_LOGIN_WINDOW=15m
AUTH_SESSION_TOUCH_INTERVAL=5m

# Bootstrap administrator (used only by `go run ./cmd/user`).
# Keep the real password in the shell environment, never in this file.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

